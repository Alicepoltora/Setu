# Setu testnet inventory（最小可用版）
# 复制为 inventory.env，填入真实值；禁止入仓库
# 所有 phaseNN.sh 会自动 source 同目录下的 inventory.env

# ── 主机别名 → 真实 IP/域名 映射 ─────────────────────────────────────────────
# 脚本通过别名（val-1/val-2/val-3/ops）操作节点，便于切换环境
declare -A HOSTS=(
  [val-1]="REPLACE-WITH-VAL1-IP"
  [val-2]="REPLACE-WITH-VAL2-IP"
  [val-3]="REPLACE-WITH-VAL3-IP"
  [ops]="REPLACE-WITH-OPS-IP"
)

# ── validator 列表（顺序与 keygen 顺序对应） ────────────────────────────────
VAL_ALIASES=(val-1 val-2 val-3)

# ── SSH 维护账户 ────────────────────────────────────────────────────────────
# Phase 1-4 之前用密码/已有 key 登录的账户（如 root 或 ubuntu）
MAINT_USER="root"
MAINT_KEY="${HOME}/.ssh/setu_maint"   # 你的维护私钥路径

# Phase 4 完成后 setu 用户用于服务管理
SETU_USER="setu"

# ── 维护源 IP 白名单（用于 UFW 放通 22） ────────────────────────────────────
# 分层策略：
#   - ops 是公网入口（80/443 已对全网开放，22 多开不显著扩大攻击面），
#     默认 22 对全网开放 + key-only + fail2ban；运维便利性最高。
#   - val 是共识节点（必须严格保护），22 仅放行 ops 跳板 + 用户 IP 段兜底；
#     这样即便 ops 短暂不可用，运维仍能直连修复。
#
# 若要更严格（牺牲便利换安全），可把 MAINT_IPS_OPS 改成你的 IP 段（如 "117.173.0.0/16"）。
MAINT_IPS_OPS=(
  "0.0.0.0/0"                        # ops 22 对全网开放，靠 key + fail2ban 防护
)
MAINT_IPS_VAL=(
  "REPLACE-WITH-OPS-IP/32"           # 主通道：ops 跳板（与 HOSTS[ops] 一致）
  "REPLACE-WITH-YOUR-PUBLIC-CIDR"    # 兜底：你的家宽/办公出口段，例 "117.173.0.0/16"；ops 故障时直连用
)

# ── 端口 ────────────────────────────────────────────────────────────────────
HTTP_PORT=8080
P2P_PORT=9000
SOLVER_PORT=9001
GATEWAY_HTTPS_PORT=443

# ── Gateway（anti-spam 阶段 1）───────────────────────────────────────────
GATEWAY_ALIAS="ops"                       # 复用 ops 节点作网关；未来独立机器只需改此行
GATEWAY_DOMAIN="REPLACE-WITH-DOMAIN"      # 例：testnet.setu.example，用于 TLS 证书
GATEWAY_TLS_EMAIL="REPLACE-WITH-EMAIL"    # certbot 注册邮箱（空则跳过 TLS）
GATEWAY_RATE_WRITE="5r/s"                 # 写接口 per-IP 速率
GATEWAY_RATE_READ="50r/s"                 # 读接口 per-IP 速率
GATEWAY_BURST_WRITE=10
GATEWAY_BURST_READ=100
GATEWAY_MAX_CONN=20                       # per-IP 并发连接上限
# ── 远端目录 ────────────────────────────────────────────────────────────────
SETU_HOME=/opt/setu

# ── ops 本地路径 ────────────────────────────────────────────────────────────
SETU_SRC=/opt/setu-src/Setu             # repo clone 位置
SETU_BUILD_ROOT=/opt/setu-build         # 编译产物 staging
KEY_DIR_LOCAL="${SETU_SRC}/deploy/testnet/keys"
GENESIS_LOCAL="${SETU_SRC}/deploy/testnet/genesis-remote.json"

# ── 编译选项 ────────────────────────────────────────────────────────────────
# diag-root-drift 是 V1 ACCEPT 的硬性要求：编译进 H1–H5 root-drift 探针，
# 一旦 BUG-010 家族 bug 复发可立即在日志中定位。
# 详见 docs/release-doc/test-v1-inner/02-build-and-deploy-flags.md。
# 禁止移除；phase08 会在编译后用 strings 校验目标串是否存在，缺失则 fail。
CARGO_FEATURES="diag-root-drift"

# ── SSH 选项 ────────────────────────────────────────────────────────────────
SSH_OPTS="-o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 -o ServerAliveInterval=30"

# ── 监控密码（**不要**写在 inventory.env 里，也不要 commit）─────────────────
# Phase 13 之前在 shell 里临时 export，避免落盘：
#   read -rsp 'grafana admin pw: ' GRAFANA_ADMIN_PASSWORD; export GRAFANA_ADMIN_PASSWORD; echo
# phase13-monitoring.sh 会读取该环境变量并注入到 grafana 容器。

# ── Raw transfer 运营 token（**不要**写在 inventory.env 里，也不要 commit）──
# V1 ACCEPT 的硬性要求：funding fixture / P1 aggregator / benchmark 都需要此 token，
# 缺失会让相关测试静默退化到 0/N 通过。详见 docs/release-doc/test-v1-inner/02-build-and-deploy-flags.md。
#
# 首次部署在 ops 上生成一次，保存到密码管理器，3 台 validator 必须共享同一值：
#   openssl rand -hex 32 > /tmp/setu-raw-token; chmod 600 /tmp/setu-raw-token
#
# 每次跑 phase10 / phase11 之前 export：
#   export SETU_RAW_TRANSFER_API_TOKEN="$(cat /tmp/setu-raw-token)"
#
# phase10 会把它渲染到 /opt/setu/conf/env（root:setu 0640），
# phase11 的 systemd unit 通过 EnvironmentFile=-/opt/setu/conf/env 加载。
# 未 export 时 phase10 仅警告并跳过 env 渲染（用于仅刷 genesis 场景）。
